---
import NoEncontradaLayout from '../layouts/NoEncontradaLayout.astro';

// Obtenemos la URL solicitada que causó el 404
const pathname = Astro.url.pathname;
---

<NoEncontradaLayout titulo="404 - Página no encontrada">
  <main class="min-h-[calc(100vh-80px)] flex flex-col items-center justify-center p-6 bg-slate-50 text-slate-800">
    <!-- Tarjeta Principal con la línea de acento naranja -->
    <div class="max-w-md w-full bg-white rounded-2xl shadow-xl border border-slate-200 p-8 text-center relative overflow-hidden">
      
      <!-- Barra superior naranja tenue de acento -->
      <div class="absolute top-0 left-0 right-0 h-1.5 bg-orange-500"></div>

      <!-- Ícono de Advertencia / 404 -->
      <div class="w-16 h-16 bg-orange-100 text-orange-600 rounded-full flex items-center justify-center mx-auto mb-6 shadow-inner">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0zm-9 3.75h.008v.008H12v-.008z" />
        </svg>
      </div>

      <!-- Título de Error -->
      <h1 class="text-4xl font-extrabold text-slate-900 mb-2 tracking-tight">404</h1>
      <h2 class="text-lg font-semibold text-slate-700 mb-3">Página no encontrada</h2>
      
      <p class="text-sm text-slate-500 mb-6">
        La ruta a la que intentas acceder no existe o fue movida a otra ubicación dentro del sistema.
      </p>

      <!-- Elemento de la insignia Path (Estilo Astro) -->
      <div class="inline-flex items-center space-x-2 bg-slate-900 text-slate-200 font-mono text-xs px-4 py-2 rounded-lg border border-slate-700 shadow-sm mb-8">
        <span class="text-slate-400">Path:</span>
        <span class="text-orange-400 font-semibold">{pathname}</span>
      </div>

      <!-- Botón de acción hacia el Inicio -->
      <div>
        <a
          href="/"
          class="inline-flex items-center justify-center w-full bg-orange-600 hover:bg-orange-700 text-white font-medium text-sm py-2.5 px-5 rounded-xl shadow-md transition-colors duration-200"
        >
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 mr-2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
          </svg>
          Volver al Inicio
        </a>
      </div>

    </div>
  </main>
</NoEncontradaLayout>