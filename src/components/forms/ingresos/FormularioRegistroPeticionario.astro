---
import BtnSubmit from "../../components_forms/BtnSubmit.astro";
import DivMensajeEstado from "../../components_forms/DivMensajeEstado.astro";
import InputGeneral from "../../components_forms/InputGeneral.astro";
import SelectInput from "../../components_forms/SelectInput.astro";
import FormularioBusquedaInicio from '../genericos/FormularioBusquedaInicio.astro';
import FormularioMainCol2 from "../genericos/FormularioMainCol2.astro";

---

<main class="max-w-7xl mx-auto my-6 px-4 space-y-6">


  <!-- ========================================== -->
  <!-- FORMULARIO 1: BÚSQUEDA DE C.U.R.P.         -->
  <!-- ========================================== -->
  <FormularioBusquedaInicio
    titulo_formulario = 'Buscar CURP peticionario.'
    paso_formulario="1"
    mensaje_formulario="Ingresa la CURP del peticionario para consultar si ya esta registrado."
    label_input="CURP Peticionario"
    name_input="curp"
    placeholder_input="INGRESA CURP (18 CARACTERES)"
    max_input="18"
    min_input="18"
    mensaje_submit="Buscar CURP"
    nombre_submit="Curp"
    titulo_mensaje_alerta="CURP REGISTRADA"
    mensaje_alerta="La CURP ingresada ya se encuentra registrada. Ve al formulario de 'Domicilios' para continuar."
    titulo_mensaje_positivo="CURP NO REGISTRADA"
    mensaje_positivo="La CURP no ha sido registrada. Puedes continuar con el formulario en el paso 2."
    mensaje_estado_neutro="El resultado de la busqueda por CURP aparecerá en este apartado."
  />

  <!-- ========================================== -->
  <!-- FORMULARIO 2: REGISTRO COMPLETO            -->
  <!-- ========================================== -->
  <FormularioMainCol2
    paso="2"
    titulo_general="Información General y Domicilio"
    titulo_col_1 = "Información del Peticionario"
    titulo_col_2 = "Domilicio del Peticionario"
    titulo_submit = "Registrar Peticionario"
    nombre_submit = "submit_registrar_peticionario"
  >
    <!-- Inputs Columna 1 -->
    <InputGeneral slot="col_1" label="Nombre peticionario" name="nombre_1" placeholder="Primer nombre" required/>
    <InputGeneral slot="col_1" label="Segundo nombre peticionario" name="nombre_2" placeholder="Segundo nombre" />
    <InputGeneral slot="col_1" label="Primer apellido peticionario" name="apellido_1" placeholder="Primer apellido" required/>
    <InputGeneral slot="col_1" label="Segundo apellido peticionario" name="apellido_2" placeholder="Segundo apellido" />
    <InputGeneral slot="col_1" label="C.U.R.P. peticionario" name="curp" placeholder="C.U.R.P." required/>
    <InputGeneral slot="col_1" label="Número de identificación" name="numero_identificacion" placeholder="Número identificación"/>
    <InputGeneral slot="col_1" label="Fecha de nacimiento" type="date" name="fecha_nacimiento" placeholder="Número identificación" required/>
    <SelectInput slot="col_1" label="Tipo identificación" name="id_tipo_identificacion"  required/>
    <SelectInput slot="col_1" label="Nacionalidad" name="id_nacionalidad"  required/>
    <SelectInput slot="col_1" label="Género" name="id_genero"  required/>
    <SelectInput slot="col_1" label="Tipo de Persona" name="id_tipo_persona"  required/>

    <!-- Inputs Columna 2 -->
    <InputGeneral slot="col_2" label="Calle" name="calle" placeholder="Ej: Gladiolas" required />
    <InputGeneral slot="col_2" label="Número exterior" name="numero_exterior" placeholder="Ej: 47" required />
    <InputGeneral slot="col_2" label="Número interior" name="numero_interior" placeholder="Ej: casa 2" />
    <InputGeneral slot="col_2" label="Entrecalle 1" name="calle1" placeholder="Ej: Francisco Goytia" />
    <InputGeneral slot="col_2" label="Entrecalle 2" name="calle2" placeholder="Ej: Cuitlahuac" />
    <InputGeneral slot="col_2" label="Codigo Postal" name="codigo_postal" minlength="5" maxlength="5" placeholder="Ej: 16070" required />
    <SelectInput  slot="col_2" label="Asentamiento" name="id_asentamiento" placeholder="-- Ingresa C.P. --" disabled required />
    <InputGeneral slot="col_2" label="Tipo asentamiento" name="tipo_asentamiento" placeholder="-- Selecciona asentamiento --" disabled />
    <InputGeneral slot="col_2" label="Municipio / Alcaldía" name="municipio" placeholder="-- Selecciona asentamiento --" disabled />
    <InputGeneral slot="col_2" label="Entidad Federativa" name="estado" placeholder="-- Selecciona asentamiento --" disabled />

            
  </FormularioMainCol2>
</main>