---
import type { HTMLAttributes } from 'astro/types';

interface Option {
    texto: string;
    valor: string | number;
}

interface Props extends HTMLAttributes<'select'>{
    label: string;
    name: string;
    options: Option[];
    placeholder?: string;
}

const {label, name, options = [], placeholder = '-- Seleciona una opción --', class: className, ...rest } = Astro.props
---

<div>

    <label for={name} class="block text-sm font-semibold text-slate-700 mb-2">
        {label}
    </label>

    <div class="relative">

        <select 
            id={name} 
            name={name} 
            class:list={[
                "w-full px-2 py-3 text-sm bg-transparent border-b-2 border-t-0 border-x-0 border-orange-100 text-slate-800 invalid:text-slate-400 rounded-none focus:outline-none focus:border-orange-600 focus:ring-0 transition-colors appearance-none cursor-pointer",
                className
            ]}
            {...rest}
        >
                Opción para mostrar como placeholder, se desactiva cuando intentamos seleccionar alguna opcion valida
                <option value="" disabled selected hidden>
                    {placeholder}
                </option>

                <!-- Opciones por props (dinamicas) -->

                {options.map( (opcion)=>(
                    <option value={opcion.valor} class="bg-white text-slate-800">
                        {opcion.texto}
                    </option>
                ))}

        </select>

        <!-- Flecha desplegable personalizadda (SVG) -->
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-slate-500">
            <svg class="w-4 h-4 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
        </div>
        
    </div>
</div>