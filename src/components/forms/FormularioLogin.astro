---

import BtnSubmit from "../components_forms/BtnSubmit.astro";
import DivMensajeEstado from "../components_forms/DivMensajeEstado.astro";
import InputGeneral  from "../components_forms/InputGeneral.astro";

---

<div class="w-full max-w-sm mx-auto bg-white p-10 rounded-2xl shadow-sm border border-slate-100">
  
    <!-- Encabezado -->
    <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight text-orange-600">
            Inicia sesión
        </h1>
        <p class="text-sm text-slate-500 mt-2">
            Por favor completa el formulario para iniciar sesión.
        </p>
    </div>

    <!-- Formulario -->
    <form id='formulario_iniciar_usuario' class="space-y-6" action="#" method="POST">

        <InputGeneral label="Usuario" name="usuario" placeholder="Cuenta usuario" required/>
        <InputGeneral label="Contraseña" name="clave" type='password' placeholder="********" required/>

        <BtnSubmit accion="Iniciar Sesión"/>

    </form>
    <!-- Contenedor de mensaje de estado -->

    <DivMensajeEstado />

</div>