---

<!-- Contenedor principal -->
<section class="w-full max-w-3xl mx-auto my-10 bg-white rounded-2xl shadow-sm border border-slate-100 p-6 md:p-8">

    <!-- Encabezado superior con badge -->
    <div class="flex items-center gap-3 mb-6">
        <span class="px-3 py-1 rounded-full bg-slate-800 text-white text-xs font-semibold tracking-wide">
            Catálogo
        </span>
        <h1 class="text-lg md:text-xl font-bold text-slate-800">
            Gestión de Días Inhábiles
        </h1>
    </div>

    <!-- Tarjeta única del formulario -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6">

        <!-- Subtítulo con píldora naranja -->
        <div class="flex items-center gap-2.5 pb-4 mb-6 border-b border-slate-100">
            <span class="w-1.5 h-5 rounded-full bg-orange-500"></span>
            <h2 class="text-base font-bold text-slate-800">
            Registrar Día Inhábil
            </h2>
        </div>

        <!-- Formulario -->
        <form id="form-dias-inhabiles" class="space-y-6">

            <!-- Grid interno de 2 campos en fila (Fecha + Estatus) y Motivo abajo -->
            <div class="grid grid-cols-1 gap-y-6">

                <!-- Slot 1: Fecha inhábil -->
                <div>
                     <slot name="input_1"/>
                </div>
                    
                
                <div>
                    <slot name="input_2"/>
                </div>

            </div>

            <!-- Botones de acción -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
            <!-- Aquí van tus componentes de botón (Reset / Submit) -->
                <slot name="botonesFormulario"/>
            </div>

        </form>

        <!-- Contenedor de mensajes de estado -->
        <div class="mt-4">
            <!-- <DivMensajeEstado /> -->
            <slot name="mensaje_estado" />
        </div>

    </div>

</section>