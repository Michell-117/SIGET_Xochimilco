---

---

<div id="banner-estado-registro" class="hidden mb-6 rounded-xl p-4 transition-all duration-300 border">

  <div class="flex items-start gap-3">

    <!-- Ícono Dinámico -->
    <div id="banner-icono" class="shrink-0 p-1 rounded-lg">
      <!-- El SVG del icono se inserta o cambia dinámicamente -->
    </div>
    
    <!-- Mensaje -->
    <div class="flex-1">
      <h4 id="banner-titulo" class="text-sm font-bold uppercase tracking-wide"></h4>
      <p id="banner-mensaje" class="text-xs mt-0.5"></p>
    </div>

    <!-- Botón para cerrar manualmente -->
    <button type="button" id="btn-cerrar-banner" class="text-slate-400 hover:text-slate-600">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

  </div>

</div>