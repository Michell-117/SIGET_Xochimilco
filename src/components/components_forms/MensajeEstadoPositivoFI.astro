---
import AfirmativoIcon from "../../icons/AfirmativoIcon.astro";

interface Props {
    name: string;
    titulo_mensaje: string;
    mensaje: string;
}

const {name, titulo_mensaje, mensaje} = Astro.props
---

<div id={name} class="hidden bg-emerald-50 border border-emerald-200/80 rounded-xl p-3.5 items-start gap-3">

    <div class="p-1 bg-emerald-100 rounded-lg text-emerald-600 shrink-0 mt-0.5">
        <AfirmativoIcon />
    </div>

    <div>

        <span class="text-xs font-bold text-emerald-800 uppercase tracking-wide block">
            {titulo_mensaje}
        </span>

        <p class="text-xs text-emerald-700 mt-0.5">
            {mensaje}
        </p>

    </div>

</div>