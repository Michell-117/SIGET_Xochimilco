---
interface Props {
    titulo:string;
    nombre:string
}

const {titulo, nombre} = Astro.props
---

<button 
    type="submit"
    name={nombre}
    class="bg-orange-600 hover:bg-orange-700 active:bg-orange-800 text-white text-sm font-bold px-7 py-3 rounded-xl shadow-md hover:shadow-lg transition-all duration-150 flex items-center justify-center gap-2.5 shrink-0 cursor-pointer"
>
    <slot/>

    <span>{titulo}</span>
    
</button>