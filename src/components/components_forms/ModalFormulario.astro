---
import AfirmativoIcon from "../../icons/AfirmativoIcon.astro";

interface Props {
  id_modal: string;
  titulo_modal: string;
  mensaje_modal: string;
  boton_modal: string;
}

const {id_modal,titulo_modal,mensaje_modal,boton_modal} = Astro.props
---

<!-- Componente SuccessModal.astro -->
<div id={id_modal} class="fixed flex hidden inset-0 z-50 items-center justify-center bg-slate-900/50 backdrop-blur-sm p-4">

  <div class="bg-white rounded-2xl shadow-xl max-w-md w-full p-6 text-center space-y-4 animate-in fade-in zoom-in-95 duration-200">
    <div class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto">
      <AfirmativoIcon />
    </div>
    
    <div class="space-y-1">
      <h3 class="text-lg font-bold text-slate-800">{titulo_modal}</h3>
      <p class="text-sm text-slate-500" id="modal-exito-mensaje">{mensaje_modal}</p>
      <p class="text-sm text-slate-800" id="modal-exito-mensaje">CURP Peticionario</p>
      <p id='curp-peticionario-registrado' class="text-sm text-slate-500" id="modal-exito-mensaje"></p>
      <p class="text-sm text-slate-800" id="modal-exito-mensaje">Id Peticionario:</p>
      <p id="id-peticionario-registrado" class="text-sm text-slate-500" id="modal-exito-mensaje"></p>
    
    </div>

    <div class="pt-2 flex flex-col gap-2">
      <button 
        type="button" 
        onclick="location.reload()" 
        class="w-full bg-orange-600 hover:bg-orange-700 text-white font-semibold py-2.5 rounded-xl transition-colors text-sm"
      >
        {boton_modal}
      </button>
    </div>
  </div>
</div>